# XPMI Protected Case Library
# Both variables are required. Do not commit .env.local to version control.

# Password for accessing the protected case library.
XPMI_CASE_PASSWORD=your-password-here

# Secret key for signing session cookies (HMAC-SHA256).
# Must be a strong, unique, random string.
# If missing, authentication will return HTTP 500.
XPMI_COOKIE_SECRET=your-random-secret-here
